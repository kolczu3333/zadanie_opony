#
# After clone, run inside the app container:
#   bin/console secrets:decrypt-to-local --env=dev
#
# Or set secrets manually:
#   bin/console secrets:set MYSQL_PASSWORD --env=dev
#   bin/console secrets:set MYSQL_ROOT_PASSWORD --env=dev
#   bin/console secrets:set APP_SECRET --random --env=dev
#   bin/console secrets:decrypt-to-local --env=dev
#
# Example values for local development (match config/secrets/dev vault):

APP_SECRET=change-me-after-secrets-generate-keys
MYSQL_PASSWORD=stock
MYSQL_ROOT_PASSWORD=root
