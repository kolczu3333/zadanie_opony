# Copy to .env.local for local overrides (optional).
# Passwords are NOT stored here — use Symfony secrets (see README).

###> symfony/framework-bundle ###
APP_ENV=dev
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
MYSQL_USER=stock
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=stock
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
